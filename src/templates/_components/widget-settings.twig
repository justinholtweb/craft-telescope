{% import '_includes/forms.twig' as forms %}

{{ forms.selectField({
    label: 'Period'|t('telescope'),
    id: 'period',
    name: 'period',
    options: periodOptions,
    value: widget.period,
}) }}

{{ forms.textField({
    label: 'Rows'|t('telescope'),
    instructions: 'How many pages to list. Leave blank to use the plugin default.'|t('telescope'),
    id: 'limit',
    name: 'limit',
    type: 'number',
    min: 1,
    max: 50,
    size: 4,
    value: widget.limit,
    errors: widget.getErrors('limit'),
}) }}

{% if craft.app.isMultiSite %}
    {{ forms.selectField({
        label: 'Site'|t('telescope'),
        id: 'siteId',
        name: 'siteId',
        options: [{ label: 'Current site'|t('telescope'), value: '' }]|merge(
            craft.app.sites.getEditableSites()|map(site => { label: site.name, value: site.id })|values
        ),
        value: widget.siteId,
    }) }}
{% endif %}
